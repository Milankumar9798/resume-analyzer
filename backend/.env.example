# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/resume_analyzer
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret_string_min_32_chars
JWT_EXPIRATION_MS=604800000

# Groq API (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# CORS - frontend origin
CLIENT_URL=http://localhost:5173

# AI rate limit (requests per user per hour)
AI_RATE_LIMIT=30

# Server port
PORT=8080

# Set these as actual environment variables (or a .env loaded by your process
# manager) - do NOT commit real values. Spring Boot reads application.yml
# placeholders like ${GROQ_API_KEY} directly from the environment.
